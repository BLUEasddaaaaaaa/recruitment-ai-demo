# OpenAI API key. Leave empty when using fake mode.
OPENAI_API_KEY=
# OpenAI model identifier. Set explicitly when AI_MODE=real.
OPENAI_MODEL=
# SQLModel database connection URL.
DATABASE_URL=sqlite:///data/recruitment.db
# AI execution mode (fake or real).
AI_MODE=fake
# WeCom bot webhook URL. Leave empty to disable notifications.
WECOM_WEBHOOK_URL=
# Tencent Docs integration mode (mock or real).
TENCENT_DOCS_MODE=mock
